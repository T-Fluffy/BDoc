# Copy to .env (gitignored) and generate a real secret. Never commit .env.
#
#   PowerShell:  -join ((48..57+65..90+97..122) | Get-Random -Count 48 | % {[char]$_})
#   Bash:        openssl rand -base64 48
#
# Minimum 32 characters. Changing it invalidates all existing tokens (users re-login once).
JWT_KEY=change-me-generate-a-random-secret-at-least-32-chars
